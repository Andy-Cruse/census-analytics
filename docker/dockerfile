# Smaller alternative
FROM rocker/tidyverse:4.3.0

WORKDIR /app

# Install system dependencies for spatial packages
RUN apt-get update && \
    apt-get install -y \
    libudunits2-dev \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    && rm -rf /var/lib/apt/lists/*

# Install only what you need
RUN R -e "install.packages(c('tidycensus', 'tigris', 'leaflet'))"

COPY scripts/ ./scripts/
RUN mkdir -p data/raw data/processed output

CMD ["sh", "-c", "Rscript scripts/01_fetch_data.R && Rscript scripts/02_create_map.R"]